<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.dao.GuancedianDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.entity.GuancedianEntity" id="guancedianMap">
        <result property="biaoti" column="biaoti"/>
        <result property="shijian" column="shijian"/>
        <result property="weizhi" column="weizhi"/>
        <result property="tupian" column="tupian"/>
        <result property="jiluxiangqing" column="jiluxiangqing"/>
        <result property="jilushijian" column="jilushijian"/>
        <result property="zhanghao" column="zhanghao"/>
        <result property="longitude" column="longitude"/>
        <result property="latitude" column="latitude"/>
        <result property="fulladdress" column="fulladdress"/>
