	<select id="selectListVO"
		resultType="com.entity.vo.GuancedianVO" >
		SELECT * FROM guancedian  guancedian         
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectVO"
		resultType="com.entity.vo.GuancedianVO" >
		SELECT  guancedian.* FROM guancedian  guancedian 	
 		<where> 1=1 ${ew.sqlSegment}</where>
	</select>

    <select id="selectListView"
		resultType="com.entity.view.GuancedianView" >

		SELECT  guancedian.* FROM guancedian  guancedian 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.entity.view.GuancedianView" >
		SELECT * FROM guancedian  guancedian <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	


</mapper>
